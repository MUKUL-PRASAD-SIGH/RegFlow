# Airflow (v2 orchestration) — copy values into .env or export before `docker compose up`
#
# Postgres init script docker/postgres/init-airflow-db.sql runs only on first
# postgres_data volume creation. To recreate the airflow DB on an existing volume:
#   docker compose exec postgres psql -U rguser -c "CREATE DATABASE airflow;"

# Prefer the image default user (airflow). Do NOT set AIRFLOW_UID=0 on Windows —
# that runs as root and loses access to /home/airflow/.local site-packages.
# AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rguser:rgpass123@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
REDIS_URL=redis://redis:6379/0
PYTHONPATH=/opt/airflow/reggraph
